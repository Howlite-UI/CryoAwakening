{
  "multipart": [
    {
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_core"
      }
    },
    {
      "when": {
        "north": "normal"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_arm"
      }
    },
    {
      "when": {
        "north": "extract"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_out"
      }
    },
    {
      "when": {
        "south": "normal"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_arm",
        "y": 180
      }
    },
    {
      "when": {
        "south": "extract"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_out",
        "y": 180
      }
    },
    {
      "when": {
        "east": "normal"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_arm",
        "y": 90
      }
    },
    {
      "when": {
        "east": "extract"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_out",
        "y": 90
      }
    },
    {
      "when": {
        "west": "normal"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_arm",
        "y": 270
      }
    },
    {
      "when": {
        "west": "extract"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_out",
        "y": 270
      }
    },
    {
      "when": {
        "up": "normal"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_arm",
        "x": 270
      }
    },
    {
      "when": {
        "up": "extract"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_out",
        "x": 270
      }
    },
    {
      "when": {
        "down": "normal"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_arm",
        "x": 90
      }
    },
    {
      "when": {
        "down": "extract"
      },
      "apply": {
        "model": "cryo-awakening:block/gale_pipe_out",
        "x": 90
      }
    }
  ]
}