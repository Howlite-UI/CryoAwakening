{
	"schemaVersion": 1,
	"id": "cryo-awakening",
	"version": "${version}",
	"name": "Cryo Awakening",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cryo-awakening/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.howlite.cryoawakening.CryoAwakening",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.howlite.cryoawakening.client.CryoAwakeningClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.howlite.cryoawakening.client.CryoAwakeningDataGenerator",
				"adapter": "kotlin"
			}
		],
		"jei_mod_plugin": [
			{
				"value": "com.howlite.cryoawakening.client.compat.jei.CryoAwakeningJeiPlugin",
				"adapter": "kotlin"
			}
		],
		"jei": [
			{
				"value": "com.howlite.cryoawakening.client.compat.jei.CryoAwakeningJeiPlugin",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cryo-awakening.mixins.json",
		{
			"config": "cryo-awakening.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"geckolib": "*"
	}
}